---
import '@/assets/styles/global.css';
import AnnouncementBar from '@/components/layout/AnnouncementBar.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, ogImage = '/og-image.png', description = 'Custom 4WD and van fit-outs on the Gold Coast, QLD. Expedition cabinetry, water systems and off-grid power - designed in 3D, built from premium plywood and professionally installed.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: 'Bush Bound',
  url: new URL('/', Astro.site).href,
  description: 'Custom 4WD, Troop Carrier and van fit-outs. Expedition cabinetry, water systems and off-grid power, designed in 3D and built on the Gold Coast.',
  telephone: '+61424770875',
  email: 'luke@bushbound.au',
  image: new URL('/og-image.png', Astro.site).href,
  logo: new URL('/icon-512.png', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Gold Coast',
    addressRegion: 'QLD',
    addressCountry: 'AU',
  },
  areaServed: { '@type': 'Country', name: 'Australia' },
  sameAs: [
    'https://www.instagram.com/bushboundau/',
    'https://www.facebook.com/p/BushBound-61555491587865/',
    'https://www.tiktok.com/@bushboundau',
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImageURL} />
    {ogImage === '/og-image.png' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} is:inline />

    <!-- Fonts (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <AnnouncementBar />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Scroll animations -->
    <script>
      import anime from 'animejs';

      function initAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              const el = entry.target as HTMLElement;
              const type = el.dataset.animate;

              if (type === 'fade-up') {
                anime({
                  targets: el,
                  opacity: [0, 1],
                  translateY: ['2rem', '0'],
                  duration: 800,
                  easing: 'easeOutCubic',
                });
              }

              if (type === 'fade-in') {
                anime({
                  targets: el,
                  opacity: [0, 1],
                  duration: 800,
                  easing: 'easeOutCubic',
                });
              }

              if (type === 'scale-in') {
                anime({
                  targets: el,
                  opacity: [0, 1],
                  scale: [0.95, 1],
                  duration: 800,
                  easing: 'easeOutCubic',
                });
              }

              if (type === 'stagger') {
                el.style.opacity = '1';
                anime({
                  targets: el.children,
                  opacity: [0, 1],
                  translateY: ['1.5rem', '0'],
                  delay: anime.stagger(120),
                  duration: 600,
                  easing: 'easeOutCubic',
                });
              }

              observer.unobserve(el);
            });
          },
          { threshold: 0.05, rootMargin: '0px' }
        );

        document.querySelectorAll('[data-animate]').forEach((el) => {
          observer.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initAnimations);
      initAnimations();
    </script>
  </body>
</html>
