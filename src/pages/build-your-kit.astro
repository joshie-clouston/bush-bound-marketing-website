---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';

const usps = [
  { title: 'CNC cut to the millimetre', text: 'No panel saw, no wobbly jigsaw lines. Every panel is machine cut, numbered and pre-drilled.' },
  { title: 'Floor template included', text: 'Drill exactly where it\'s safe. Our template keeps you clear of fuel tanks, brake lines and wiring.' },
  { title: 'Materials dialled in', text: 'The same premium birch ply, slides and hardware we use in our full workshop builds.' },
  { title: 'Build it in a weekend', text: 'A drill, a few clamps and a mate. Or add our build and install service if you\'d rather not.' },
];

const comparison = [
  { label: 'Design time', diy: 'Weeks of YouTube and sketching', kit: 'Done for you in 3D, approved before we cut' },
  { label: 'Cutting', diy: 'Panel saw or circular saw, rough edges', kit: 'CNC cut, clean edges, perfect joins' },
  { label: 'Materials', diy: 'Guesswork at the hardware store', kit: 'Premium birch ply and rated slides' },
  { label: 'Floor mounting', diy: 'Fingers crossed you miss the fuel tank', kit: 'Vehicle-specific floor template' },
  { label: 'Build time', diy: 'Most weekends for a couple of months', kit: 'One weekend' },
];

const viewerBtn = 'min-h-[44px] bg-black/35 hover:bg-black/50 backdrop-blur text-stone-light text-xs font-semibold px-3 rounded-md transition-colors';
---

<BaseLayout
  title="Build Your Flat Pack Fit-Out Kit | DIY 4WD Wagon Kits | Bush Bound"
  description="Design your own flat pack 4WD fit-out kit for your LandCruiser, Patrol, Prado and more. Pick your fridge and options, watch it build in 3D, and get an official quote."
>
  <style is:global>
    #viewer-canvas canvas { width: 100% !important; height: 100% !important; display: block; }
    /* Keep the options in view below the pinned 3D viewer on phones. */
    #question-panel { scroll-margin-top: calc(6.25rem + max(48vh, 300px) + 0.75rem); }
    @media (max-width: 1023px) {
      /* After the options page the model shrinks and scrolls away, so forms and errors are never hidden under it. */
      #builder:not([data-step="0"]) #viewer-wrap { position: relative; top: auto; }
      #builder:not([data-step="0"]) #viewer { height: 30vh; min-height: 220px; }
      #builder:not([data-step="0"]) #question-panel { scroll-margin-top: 6.75rem; }
    }
    @media (min-width: 1024px) { #question-panel { scroll-margin-top: 8rem; } }
  </style>

  <!-- INTRO -->
  <section class="bg-charcoal text-stone-light">
    <div class="container-wide pt-8 pb-6 sm:pt-14 sm:pb-10">
      <p class="text-sand font-medium text-sm uppercase tracking-widest mb-3">Flat Pack Fit-Out Kits</p>
      <h1 class="text-3xl sm:text-5xl font-extrabold max-w-3xl">Build your wagon fit-out. Watch it come together.</h1>
      <p class="text-stone-dark mt-4 max-w-2xl text-base sm:text-lg">
        Pick your fridge and options, watch it build in 3D and see a price range. Flat packed and delivered to your door, or built and installed by us.
      </p>
    </div>
  </section>

  <!-- BUILDER -->
  <section class="bg-background" id="builder" data-step="0">
    <div class="container-wide py-4 lg:py-10">
      <div class="grid lg:grid-cols-12 gap-5 lg:gap-10">

        <!-- 3D viewer (pinned while you scroll) -->
        <div id="viewer-wrap" class="lg:col-span-7 lg:order-2 sticky top-[6.25rem] lg:top-[7.25rem] self-start z-20 -mx-5 sm:mx-0">
          <div id="viewer" class="relative flex flex-col h-[48vh] min-h-[300px] lg:h-[calc(100vh-9rem)] lg:max-h-[720px] sm:rounded-xl overflow-hidden bg-gradient-to-b from-[#7a7e7c] to-[#4d5150] shadow-lg lg:shadow-none">
            <div class="relative flex-1 min-h-0"><div id="viewer-canvas" class="absolute inset-0"></div></div>

            <div class="absolute top-2.5 left-3 right-3 z-10 flex items-start justify-between gap-3 pointer-events-none">
              <div class="min-w-0">
                <p id="viewer-vehicle" class="text-stone-light font-bold text-sm sm:text-base truncate">Wagon base kit</p>
                <p id="viewer-changes" class="text-stone-light/80 text-xs mt-0.5 line-clamp-1 sm:line-clamp-2"></p>
              </div>
              <div class="text-right shrink-0">
                <p data-bracket class="bg-sand text-charcoal text-sm font-extrabold px-2.5 py-1 rounded-full whitespace-nowrap">…</p>
                <p class="text-[10px] text-stone-light/75 mt-0.5">Estimated range</p>
              </div>
            </div>

            <div class="sm:absolute sm:bottom-2.5 sm:left-3 sm:right-3 flex items-center sm:items-end justify-between gap-2 px-3 py-1 sm:p-0 bg-[#4d5150] sm:bg-transparent">
              <p class="text-stone-light/75 text-[11px] leading-snug hidden sm:block max-w-[45%]">
                <span class="hidden lg:inline">Drag to rotate · Ctrl + scroll to zoom.</span>
                Tap Open to see the drawers, bed and table in action.
              </p>
              <div class="flex gap-1.5 ml-auto">
                <button id="toggle-open" type="button" aria-pressed="false" class={`${viewerBtn} min-w-[72px]`}>Open</button>
                <button id="reset-view" type="button" class={viewerBtn} aria-label="Reset 3D view">Reset</button>
              </div>
            </div>

            <div id="viewer-fallback" class="hidden absolute inset-0 items-center justify-center p-6 text-center text-stone-light/80 text-sm">
              Your browser can't show the 3D preview, but the options and quote request still work fine.
            </div>
          </div>
          <ul id="module-chips" class="hidden lg:flex flex-wrap gap-2 mt-3" aria-label="What's in your layout"></ul>
        </div>

        <!-- Steps -->
        <div class="lg:col-span-5 lg:order-1">
          <div id="question-panel" class="bg-white rounded-xl border border-stone-dark/20 p-5 sm:p-7 shadow-sm">
            <div id="panel-head" class="flex items-center justify-between gap-3 mb-4">
              <button id="back-btn" type="button" class="min-h-[44px] -ml-2 px-2 text-sm font-medium text-primary hover:text-primary-light disabled:invisible flex items-center gap-1" disabled>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                Back
              </button>
              <div class="flex items-center gap-3">
                <button id="start-over" type="button" class="min-h-[44px] px-2 text-xs font-semibold text-muted-foreground hover:text-primary underline">Start over</button>
                <p id="step-count" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Step 1 of 3</p>
              </div>
            </div>
            <div id="panel-progress" class="h-1.5 bg-stone rounded-full overflow-hidden mb-6">
              <div id="progress-bar" class="h-full bg-primary rounded-full transition-all duration-500" style="width: 33%"></div>
            </div>
            <div id="question-body" aria-live="polite"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY A KIT -->
  <section class="section-padding bg-stone">
    <div class="container-wide">
      <div class="text-center mb-12">
        <p class="text-sand-dark font-medium text-sm uppercase tracking-widest mb-3" data-animate="fade-in">Why a Bush Bound kit</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-charcoal" data-animate="fade-up">All the craftsmanship, none of the sawdust</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6" data-animate="stagger">
        {usps.map((u) => (
          <div class="bg-white rounded-xl p-6 border border-stone-dark/10">
            <h3 class="text-lg font-bold text-charcoal mb-2">{u.title}</h3>
            <p class="text-sm text-muted-foreground">{u.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 bg-white rounded-xl border border-stone-dark/10 overflow-hidden" data-animate="fade-up">
        <div class="grid grid-cols-3 text-xs sm:text-sm font-semibold bg-charcoal text-stone-light">
          <div class="p-3 sm:p-4"></div>
          <div class="p-3 sm:p-4">Doing it from scratch</div>
          <div class="p-3 sm:p-4 text-sand">Bush Bound kit</div>
        </div>
        {comparison.map((row) => (
          <div class="grid grid-cols-3 text-xs sm:text-sm border-t border-stone-dark/10">
            <div class="p-3 sm:p-4 font-semibold text-charcoal">{row.label}</div>
            <div class="p-3 sm:p-4 text-muted-foreground">{row.diy}</div>
            <div class="p-3 sm:p-4 text-charcoal">{row.kit}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <script>
    import { BUILD_OPTIONS, DEFAULT_STORAGE, ORDERING, QUESTIONS, VEHICLES, getVehicle, type VehicleId } from '@/data/kit-builder';
    import { carpetOn, recommend, sanitiseAnswers, type KitAnswers, type Recommendation } from '@/lib/kit-builder/engine';
    import { getUtmParams } from '@/lib/utm';
    import type { KitScene } from '@/lib/kit-builder/scene';

    // Steps: pick your options -> your details (lead saved) -> delivery and ordering -> done.
    const PICK = 0;
    const CONTACT = 1;
    const DETAILS = 2;
    const DONE = 3;
    const STORAGE_KEY = 'bb-kit-builder-v6';
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    // Same rule as the main quote form.
    const MOBILE_RE = /^(\+?61|0)4\d{2}\s?\d{3}\s?\d{3}$/;
    const TIMELINES = [
      { value: 'asap', label: 'ASAP' },
      { value: '3-months', label: 'Within 3 months' },
      { value: '6-months', label: 'Within 6 months' },
      { value: 'planning', label: 'Just planning' },
    ];
    const BUDGETS = [
      { value: 'under-5k', label: 'Under $5K' },
      { value: '5k-25k', label: '$5K to $25K' },
      { value: '25k-50k', label: '$25K to $50K' },
      { value: '50k-plus', label: '$50K+' },
    ];
    const REFERRALS = [
      { value: 'instagram', label: 'Instagram' },
      { value: 'facebook', label: 'Facebook' },
      { value: 'tiktok', label: 'TikTok' },
      { value: 'google', label: 'Google search' },
      { value: 'word-of-mouth', label: 'Word of mouth' },
      { value: 'other', label: 'Other' },
    ];

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const isMobile = () => window.innerWidth < 1024;
    const inputCls = 'mt-1 w-full min-h-[48px] rounded-md border border-stone-dark/40 px-3 py-2.5 text-base bg-white focus:border-primary focus:outline-none';

    let answers: KitAnswers = {};
    let step = PICK;
    /** The lead row saved on the details step, so the final request updates it instead of making a new one. */
    let lead: { email: string; leadId: number | null } | null = null;
    /** Everything typed into the forms (survives Back, re-renders and reloads). */
    let form: Record<string, string> = {};
    /** What they sent, for the thank-you screen. */
    let sent: { name: string } | null = null;
    /** They've already sent this build once; sending again updates the same request. */
    let sentBefore = false;
    let scene: KitScene | null = null;
    /** Latest price bracket from the server (we never ship prices to the browser). */
    let bracket = '';

    function withDefaults(a: KitAnswers): KitAnswers {
      a.fridge ??= 'upright-65';
      a.storage ??= [...DEFAULT_STORAGE];
      a.build ??= 'diy';
      a.finish ??= 'hex';
      return a;
    }

    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (saved && typeof saved === 'object') {
        answers = sanitiseAnswers(saved.answers);
        if (saved.form && typeof saved.form === 'object') {
          for (const [k, v] of Object.entries(saved.form)) if (typeof v === 'string') form[k] = v.slice(0, 2000);
        }
        if (saved.lead && typeof saved.lead.email === 'string') {
          lead = { email: saved.lead.email, leadId: Number.isInteger(saved.lead.leadId) ? saved.lead.leadId : null };
        }
        sentBefore = saved.sentBefore === true;
        const s = saved.step | 0;
        step = s === DETAILS && lead ? DETAILS : s === CONTACT ? CONTACT : PICK;
      }
    } catch { /* storage unavailable, start fresh */ }
    withDefaults(answers);

    function save() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ answers, step: Math.min(step, DETAILS), lead, form, sentBefore })); } catch { /* ignore */ }
    }

    // -----------------------------------------------------------------------
    // Price bracket (from the server)
    // -----------------------------------------------------------------------

    let estimateTimer = 0;
    let estimateSeq = 0;
    function requestEstimate() {
      window.clearTimeout(estimateTimer);
      estimateTimer = window.setTimeout(async () => {
        const seq = ++estimateSeq;
        try {
          const res = await fetch('/api/kit-estimate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ answers }) });
          const data = (await res.json()) as { bracket?: string };
          if (seq !== estimateSeq || !data.bracket) return;
          bracket = data.bracket;
          document.querySelectorAll('[data-bracket]').forEach((el) => { el.textContent = bracket; });
        } catch { /* keep the last bracket */ }
      }, 250);
    }

    // -----------------------------------------------------------------------
    // 3D viewer
    // -----------------------------------------------------------------------

    function webglAvailable() {
      try {
        const c = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
      } catch {
        return false;
      }
    }

    async function initScene() {
      if (!webglAvailable()) {
        const fb = $('viewer-fallback');
        fb.classList.remove('hidden');
        fb.classList.add('flex');
        return;
      }
      const { KitScene } = await import('@/lib/kit-builder/scene');
      scene = new KitScene($('viewer-canvas'));
      if (import.meta.env.DEV) (window as unknown as Record<string, unknown>).__kitScene = scene;
      refresh();
    }

    function setOpen(open: boolean) {
      const btn = $('toggle-open');
      btn.setAttribute('aria-pressed', String(open));
      btn.textContent = open ? 'Close' : 'Open';
      scene?.setOpen(open);
    }
    $('toggle-open').addEventListener('click', (e) => setOpen((e.currentTarget as HTMLElement).getAttribute('aria-pressed') !== 'true'));
    $('reset-view').addEventListener('click', () => scene?.resetView());

    const MODULE_LABELS: Record<string, string> = {
      drawer: 'Drawers',
      'fridge-upright': 'Upright fridge',
      'drawer-fridge': 'Drawer fridge',
      cubby: 'Table cubby',
      slats: 'Sliding bed',
    };

    function vehicleName() {
      if (answers.vehicle === 'other') return answers.vehicleName || 'your vehicle';
      return getVehicle(answers.vehicle).label;
    }

    function refresh(): Recommendation {
      const rec = recommend(answers);
      $('viewer-vehicle').textContent = answers.vehicle ? `${rec.kitName}: ${answers.vehicle === 'other' ? answers.vehicleName || 'Your vehicle' : rec.vehicle.short}` : rec.kitName;
      $('viewer-changes').textContent = rec.addOns.join(' · ');
      const kinds = [...new Set(rec.layout.modules.map((m) => m.kind))].filter((k) => MODULE_LABELS[k]);
      $('module-chips').innerHTML = kinds.map((k) => `<li class="text-xs font-medium bg-white border border-stone-dark/20 text-charcoal px-2.5 py-1 rounded-full">${MODULE_LABELS[k]}</li>`).join('');
      scene?.update(rec.layout, { fronts: answers.finish ?? 'hex', carpet: carpetOn(answers) });
      requestEstimate();
      return rec;
    }

    // -----------------------------------------------------------------------
    // Navigation (supports the browser Back button)
    // -----------------------------------------------------------------------

    function render() {
      $('builder').dataset.step = String(step);
      $<HTMLButtonElement>('back-btn').disabled = step === PICK;
      $('start-over').classList.toggle('hidden', step === DONE);
      $('step-count').textContent = step === DONE ? 'Sent' : `Step ${step + 1} of 3`;
      $('progress-bar').style.width = `${step === DONE ? 100 : ((step + 1) / 3) * 100}%`;
      if (step === PICK) renderPick();
      else if (step === CONTACT) renderContact();
      else if (step === DETAILS) renderDetails();
      else renderDone();
    }

    function scrollToPanel() {
      const panel = $('question-panel');
      if (isMobile() || panel.getBoundingClientRect().top < 0) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function goTo(next: number, opts: { push?: boolean; replace?: boolean } = {}) {
      // Can't skip ahead of the lead capture.
      if (next === DETAILS && !lead) next = CONTACT;
      step = next;
      save();
      if (opts.replace) history.replaceState({ kitStep: step }, '');
      else if (opts.push !== false) history.pushState({ kitStep: step }, '');
      render();
      scrollToPanel();
    }

    window.addEventListener('popstate', (e) => {
      const s = (e.state as { kitStep?: number } | null)?.kitStep;
      if (typeof s !== 'number') return;
      goTo(Math.min(s, DETAILS), { push: false });
    });

    $('back-btn').addEventListener('click', () => {
      if (step === DONE) goTo(DETAILS);
      else if (step > PICK) goTo(step - 1, { replace: true });
    });

    /** Clear the options (keeps their contact details) and go back to the first page. */
    function startOver() {
      answers = withDefaults({});
      sent = null;
      // A new build is a new request.
      if (sentBefore) lead = null;
      sentBefore = false;
      for (const k of ['notes']) delete form[k];
      setOpen(false);
      refresh();
      goTo(PICK);
    }
    $('start-over').addEventListener('click', startOver);

    function showError(id: string, message: string, focusId?: string) {
      const el = $(id);
      el.innerHTML = message;
      el.classList.remove('hidden');
      // Show the message (it sits by the button they just tapped, or under the field), then focus the field.
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (focusId ? document.getElementById(focusId) : null)?.focus({ preventScroll: true });
    }

    // -----------------------------------------------------------------------
    // Step 1: pick your options
    // -----------------------------------------------------------------------

    function optionCard(name: string, value: string, label: string, sub: string | undefined, selected: boolean, multi: boolean) {
      return `
        <button type="button" data-q="${name}" data-value="${value}" role="${multi ? 'checkbox' : 'radio'}" aria-checked="${selected}"
          class="option min-h-[56px] text-left rounded-lg border-2 px-4 py-3 transition-all ${selected ? 'border-primary bg-primary/5' : 'border-stone-dark/30 hover:border-primary/60 bg-white'}">
          <span class="flex items-start justify-between gap-2">
            <span class="block font-semibold text-charcoal text-sm sm:text-base">${escapeHtml(label)}</span>
            <span class="w-5 h-5 shrink-0 ${multi ? 'rounded' : 'rounded-full'} border-2 flex items-center justify-center text-xs ${selected ? 'bg-primary border-primary text-white' : 'border-stone-dark'}">${selected ? '&#10003;' : ''}</span>
          </span>
          ${sub ? `<span class="block text-xs text-muted-foreground mt-0.5">${escapeHtml(sub)}</span>` : ''}
        </button>`;
    }

    type SupplyKey = 'ownFridge' | 'ownBedding' | 'ownTable';
    const SUPPLY: Record<SupplyKey, { title: string; inc: [string, string]; own: [string, string] }> = {
      ownFridge: { title: 'Fridge', inc: ['Fridge included', 'We supply the fridge'], own: ['Cabinetry only', 'I\'ve got one or I\'ll buy it'] },
      ownBedding: { title: 'Mattress', inc: ['Mattress included', 'Folding mattress made to fit'], own: ['Bed only', 'I\'ll sort my own mattress'] },
      ownTable: { title: 'Table', inc: ['Table included', 'Our folding Bush Bound table'], own: ['Storage only', 'I\'ve got a table or I\'ll buy one'] },
    };

    /** Is the gear included, or are they just buying the cabinetry? */
    function supplyToggle(key: SupplyKey) {
      const s = SUPPLY[key];
      const own = answers[key] === true;
      const btn = (isOwn: boolean, [label, sub]: [string, string]) => {
        const on = own === isOwn;
        return `<button type="button" data-supply="${key}" data-own="${isOwn ? 1 : 0}" role="radio" aria-checked="${on}"
          class="min-h-[52px] text-left rounded-md border-2 px-3 py-2 transition-colors ${on ? 'border-primary bg-white' : 'border-transparent bg-white/60 hover:border-primary/40'}">
          <span class="flex items-center gap-1.5 text-sm font-semibold text-charcoal"><span class="w-3.5 h-3.5 shrink-0 rounded-full border-2 ${on ? 'border-primary bg-primary' : 'border-stone-dark'}"></span>${label}</span>
          <span class="block text-xs text-muted-foreground mt-0.5 pl-5">${sub}</span>
        </button>`;
      };
      return `<div class="grid grid-cols-2 gap-2 rounded-lg bg-stone-light p-2" role="radiogroup" aria-label="${s.title}: included or not">${btn(false, s.inc)}${btn(true, s.own)}</div>`;
    }

    function renderPick() {
      const sections = QUESTIONS.map((q) => {
        const v = (answers as Record<string, unknown>)[q.id];
        const selected = (x: string) => (Array.isArray(v) ? v.includes(x) : v === x);
        const extra = q.id === 'fridge' ? `<div class="mt-2.5">${supplyToggle('ownFridge')}</div>` : '';
        const after = (value: string) => {
          if (q.id !== 'storage' || !selected(value)) return '';
          if (value === 'bed') return supplyToggle('ownBedding');
          if (value === 'cubby') return supplyToggle('ownTable');
          return '';
        };
        return `
          <div class="mt-6 first:mt-0">
            <h3 class="text-lg font-bold text-charcoal">${escapeHtml(q.title)}</h3>
            <p class="text-sm text-muted-foreground mt-0.5 mb-3">${escapeHtml(q.help)}</p>
            <div class="grid gap-2.5" role="${q.multi ? 'group' : 'radiogroup'}" aria-label="${escapeHtml(q.title)}">
              ${q.options.map((o) => optionCard(q.id, o.value, o.label, o.sub, selected(o.value), !!q.multi) + after(o.value)).join('')}
            </div>
            ${extra}
          </div>`;
      }).join('');

      $('question-body').innerHTML = `
        <p class="text-sand-dark font-medium text-xs uppercase tracking-widest mb-2">Wagon fit-out builder</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-charcoal">Build your fit-out</h2>
        <p class="text-sm text-muted-foreground mt-2">Our wagon base kit: evenly split drawers in black honeycomb birch ply, cut to suit your vehicle. Pick your options and watch the model update. Tap <button type="button" data-open-preview class="font-semibold text-primary underline">Open</button> to see it in action.</p>
        <div class="mt-6">${sections}</div>
        <button type="button" id="next-btn" class="mt-6 w-full min-h-[52px] bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary-light transition-colors">Next: your details</button>
        <p class="mt-2 text-center text-xs text-muted-foreground">Free, no obligation. Takes about a minute.</p>
      `;
    }

    // -----------------------------------------------------------------------
    // Step 2: your details (this is where the lead is saved)
    // -----------------------------------------------------------------------

    function field(name: string, label: string, type: string, ac: string, extra = '') {
      return `
        <label class="block text-sm"><span class="font-medium text-charcoal">${label}</span>
          <input id="f-${name}" name="${name}" type="${type}" autocomplete="${ac}" ${extra} value="${escapeHtml(form[name] ?? '')}" class="${inputCls}" /></label>`;
    }

    function renderContact() {
      $('question-body').innerHTML = `
        <h2 class="text-2xl font-bold text-charcoal">Your details</h2>
        <p class="text-sm text-muted-foreground mt-1.5 mb-5">So we can send you your design and an official quote. No spam.</p>
        <form id="contact-form" class="space-y-3" novalidate>
          ${field('name', 'Name', 'text', 'name', 'maxlength="120" required')}
          ${field('email', 'Email', 'email', 'email', 'inputmode="email" maxlength="200" required')}
          ${field('phone', 'Mobile', 'tel', 'tel', 'inputmode="tel" maxlength="20" placeholder="04xx xxx xxx" required')}
          <label class="block text-sm"><span class="font-medium text-charcoal">What are you driving?</span>
            <select id="f-vehicle" name="vehicle" class="${inputCls}" required>
              <option value="">Pick your vehicle</option>
              ${VEHICLES.map((veh) => `<option value="${veh.id}" ${answers.vehicle === veh.id ? 'selected' : ''}>${escapeHtml(veh.id === 'other' ? 'Something else' : veh.label)}</option>`).join('')}
            </select></label>
          <label id="vehicle-name-wrap" class="block text-sm ${answers.vehicle === 'other' ? '' : 'hidden'}"><span class="font-medium text-charcoal">Make, model and year</span>
            <input id="f-vehicleName" type="text" maxlength="80" placeholder="e.g. 2016 Toyota Fortuner" value="${escapeHtml(answers.vehicleName ?? '')}" class="${inputCls}" /></label>
          <p id="contact-error" class="hidden text-sm text-destructive" role="alert"></p>
          <button type="submit" class="!mt-5 w-full min-h-[52px] bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary-light transition-colors disabled:opacity-60">Next</button>
        </form>
      `;
    }

    async function submitContact(btn: HTMLButtonElement) {
      $('contact-error').classList.add('hidden');
      const name = (form.name ?? '').trim();
      const email = (form.email ?? '').trim().toLowerCase();
      const phone = (form.phone ?? '').trim();
      if (!name) return showError('contact-error', 'Pop in your name.', 'f-name');
      if (!EMAIL_RE.test(email)) return showError('contact-error', 'Pop in a valid email so we can send your design.', 'f-email');
      if (!MOBILE_RE.test(phone)) return showError('contact-error', 'Pop in your mobile, like 0412 345 678.', 'f-phone');
      if (!answers.vehicle) return showError('contact-error', 'Pick what you\'re driving so we can cut it to suit.', 'f-vehicle');
      if (answers.vehicle === 'other' && !answers.vehicleName) return showError('contact-error', 'Tell us the make and model.', 'f-vehicleName');

      // One lead per build: only save a new one if we haven't got this email yet.
      if (!lead || lead.email !== email || !lead.leadId) {
        btn.disabled = true;
        btn.textContent = 'Saving...';
        let leadId: number | null = null;
        try {
          const rec = recommend(answers);
          const res = await fetch('/api/kit-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name, email, phone,
              vehicle: answers.vehicle === 'other' ? answers.vehicleName : rec.vehicle.label,
              picks: `${rec.kitName}: ${rec.addOns.join(', ')}`,
              ...getUtmParams(),
            }),
          });
          const data = (await res.json()) as { leadId?: number | null };
          leadId = typeof data.leadId === 'number' ? data.leadId : null;
        } catch { /* don't hold them up if saving the lead fails; the final request saves it anyway */ }
        lead = { email, leadId };
      }
      goTo(DETAILS);
    }

    // -----------------------------------------------------------------------
    // Step 3: delivery, timing and the rest of the quote form
    // -----------------------------------------------------------------------

    function orderingHtml() {
      const installed = answers.build === 'installed';
      const rows = [
        ['Payment', ORDERING.payment],
        ['Made in', ORDERING.make],
        installed ? ['Install', 'We book you in at our Gold Coast workshop once it\'s made'] : ['Delivery', `${ORDERING.delivery}, Australia-wide`],
      ];
      return `
        <p class="text-xs font-bold uppercase tracking-wider text-sand-dark mb-2">How ordering works</p>
        <dl class="space-y-1.5 text-sm">
          ${rows.map(([k, v]) => `<div class="flex gap-3"><dt class="w-20 shrink-0 font-semibold text-charcoal">${k}</dt><dd class="text-charcoal">${escapeHtml(v)}</dd></div>`).join('')}
          <div class="flex gap-3"><dt class="w-20 shrink-0 font-semibold text-charcoal">Estimate</dt><dd class="text-charcoal"><span data-bracket class="font-bold">${escapeHtml(bracket || '…')}</span></dd></div>
        </dl>
        <p class="mt-2.5 text-xs text-muted-foreground">${escapeHtml(ORDERING.note)}</p>`;
    }

    function chips(name: string, options: { value: string; label: string }[]) {
      return `<div class="flex flex-wrap gap-2" role="radiogroup">${options.map((o) => {
        const on = form[name] === o.value;
        return `<button type="button" data-chip="${name}" data-value="${o.value}" role="radio" aria-checked="${on}"
          class="min-h-[44px] px-3.5 rounded-full border-2 text-sm font-medium transition-colors ${on ? 'border-primary bg-primary text-primary-foreground' : 'border-stone-dark/30 text-charcoal hover:border-primary/60 bg-white'}">${o.label}</button>`;
      }).join('')}</div>`;
    }

    function renderDetails() {
      const first = (form.name ?? '').trim().split(' ')[0];
      $('question-body').innerHTML = `
        <h2 class="text-2xl font-bold text-charcoal">Almost done${first ? `, ${escapeHtml(first)}` : ''}</h2>
        <p class="text-sm text-muted-foreground mt-1.5 mb-5">A few quick ones so we can quote it properly.</p>
        <form id="details-form" class="space-y-6" novalidate>
          <fieldset>
            <legend class="text-sm font-semibold text-charcoal mb-2">How do you want it?</legend>
            <div class="grid gap-2.5" role="radiogroup">
              ${BUILD_OPTIONS.map((o) => optionCard('build', o.value, o.label, o.sub, answers.build === o.value, false)).join('')}
            </div>
          </fieldset>

          <div id="ordering-box" class="rounded-lg bg-stone-light border border-stone-dark/15 p-4">${orderingHtml()}</div>

          <div class="relative">
            <label for="loc-input" class="block text-sm font-semibold text-charcoal">${answers.build === 'installed' ? 'Where are you based?' : 'Where are we delivering to?'}</label>
            <input id="loc-input" type="text" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="loc-results" aria-autocomplete="list"
              placeholder="Type a postcode or suburb" value="${escapeHtml(form.location ?? '')}" class="${inputCls}" />
            <ul id="loc-results" role="listbox" class="hidden absolute z-30 left-0 right-0 mt-1 max-h-64 overflow-auto bg-white border border-stone-dark/30 rounded-md shadow-lg"></ul>
            <p id="loc-error" class="hidden mt-1.5 text-sm text-destructive" role="alert"></p>
          </div>

          <div>
            <p class="text-sm font-semibold text-charcoal mb-2">When do you need it?</p>
            ${chips('timeline', TIMELINES)}
          </div>

          <div>
            <p class="text-sm font-semibold text-charcoal mb-2">Rough budget for your whole setup <span class="font-normal text-muted-foreground">(optional)</span></p>
            ${chips('budget', BUDGETS)}
          </div>

          <label class="block text-sm"><span class="font-semibold text-charcoal">How did you hear about us? <span class="font-normal text-muted-foreground">(optional)</span></span>
            <select name="referral" class="${inputCls}">
              <option value="">Select one</option>
              ${REFERRALS.map((r) => `<option value="${r.value}" ${form.referral === r.value ? 'selected' : ''}>${r.label}</option>`).join('')}
            </select></label>

          <label class="block text-sm"><span class="font-semibold text-charcoal">Anything else? <span class="font-normal text-muted-foreground">(model year, 12V or 240V power, anything we should know)</span></span>
            <textarea name="notes" rows="3" maxlength="2000" class="${inputCls}">${escapeHtml(form.notes ?? '')}</textarea></label>

          <div>
            <p id="details-error" class="hidden mb-3 text-sm text-destructive" role="alert"></p>
            <button type="submit" class="w-full min-h-[52px] bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary-light transition-colors disabled:opacity-60">${sentBefore ? 'Send my updated build' : 'Get my official quote'}</button>
            <p class="mt-2 text-center text-xs text-muted-foreground">Luke will check your build and send an exact price within 48 hours.</p>
          </div>
        </form>
      `;
    }

    // Postcode / suburb lookup (same list as the main quote form).
    type Place = { postcode: string; suburb: string; state: string };
    let places: Place[] | null = null;
    let placesPromise: Promise<Place[]> | null = null;
    let matches: Place[] = [];
    let hi = -1;

    function loadPlaces(): Promise<Place[]> {
      if (places) return Promise.resolve(places);
      placesPromise ??= fetch('/data/au-postcodes.json')
        .then((r) => {
          if (!r.ok) throw new Error('postcodes');
          return r.json() as Promise<Place[]>;
        })
        .then((d) => (places = d))
        .catch((err) => {
          placesPromise = null;
          throw err;
        });
      return placesPromise;
    }

    function showMatches(list: Place[]) {
      matches = list;
      hi = -1;
      const ul = document.getElementById('loc-results');
      const input = document.getElementById('loc-input');
      if (!ul || !input) return;
      ul.innerHTML = list.map((m, i) => `<li role="option" data-place="${i}" class="px-4 py-2.5 cursor-pointer text-sm text-charcoal hover:bg-primary/10">${escapeHtml(`${m.suburb}, ${m.state} ${m.postcode}`)}</li>`).join('');
      ul.classList.toggle('hidden', !list.length);
      input.setAttribute('aria-expanded', String(!!list.length));
    }

    function pickPlace(p: Place) {
      form.suburb = p.suburb;
      form.state = p.state;
      form.postcode = p.postcode;
      form.location = `${p.suburb}, ${p.state} ${p.postcode}`;
      $<HTMLInputElement>('loc-input').value = form.location;
      showMatches([]);
      $('loc-error').classList.add('hidden');
      save();
    }

    async function submitDetails(btn: HTMLButtonElement) {
      $('details-error').classList.add('hidden');
      $('loc-error').classList.add('hidden');
      if (!form.postcode || !form.suburb || !form.state) {
        return showError('loc-error', 'Start typing your postcode or suburb, then pick it from the list.', 'loc-input');
      }
      btn.disabled = true;
      btn.textContent = 'Sending...';
      const contact = {
        name: form.name, email: form.email, phone: form.phone,
        suburb: form.suburb, state: form.state, postcode: form.postcode,
        timeline: form.timeline ?? '', budget: form.budget ?? '', referral: form.referral ?? '', notes: form.notes ?? '',
      };
      try {
        const res = await fetch('/api/kit-builder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ answers, contact, leadId: lead?.leadId ?? null, updated: sentBefore, ...getUtmParams() }),
        });
        if (!res.ok) throw new Error(String(res.status));
        // Keep the lead row so changing the build and sending again updates the same request.
        const data = (await res.json()) as { leadId?: number | null };
        lead = { email: (form.email ?? '').trim().toLowerCase(), leadId: typeof data.leadId === 'number' ? data.leadId : lead?.leadId ?? null };
      } catch {
        btn.disabled = false;
        btn.textContent = sentBefore ? 'Send my updated build' : 'Get my official quote';
        return showError('details-error', 'Something went wrong sending that. Give it another go, or call us on <a class="underline" href="tel:+61424770875">0424 770 875</a>.');
      }
      sent = { name: form.name ?? '' };
      sentBefore = true;
      step = DONE;
      save();
      history.pushState({ kitStep: DONE }, '');
      render();
      $('question-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
      import('canvas-confetti').then(({ default: confetti }) => {
        confetti({ particleCount: 120, spread: 70, origin: { y: 0.7 }, colors: ['#2D4A3E', '#C4A882', '#E8E0D6'] });
      }).catch(() => {});
    }

    // -----------------------------------------------------------------------
    // Done
    // -----------------------------------------------------------------------

    function renderDone() {
      const rec = recommend(answers);
      const first = (sent?.name ?? '').trim().split(' ')[0];
      const groups = (['Cabinetry', 'Gear', 'Power'] as const)
        .map((g) => ({ g, items: rec.items.filter((i) => i.group === g) }))
        .filter((x) => x.items.length);
      const steps = [
        'We check your picks and send your official quote within 48 hours',
        'We confirm your design and exact price with you',
        'Full payment up front locks it in',
        answers.build === 'installed' ? `We make it (${ORDERING.make}), then book your install` : `We make it: ${ORDERING.make}`,
        ...(answers.build === 'installed' ? [] : [`Delivered to your door: ${ORDERING.delivery}`]),
      ];
      $('question-body').innerHTML = `
        <div class="bg-primary text-primary-foreground rounded-xl p-5 sm:p-6">
          <h2 class="text-2xl font-extrabold">Thanks${first ? ` ${escapeHtml(first)}` : ''}, we've got it.</h2>
          <p class="mt-2 text-stone-light/90 text-sm">Luke will check your build for your ${escapeHtml(vehicleName())} and send your official quote within 48 hours. We've emailed you a copy.</p>
        </div>

        <div class="mt-5">
          <p class="text-xs font-bold uppercase tracking-wider text-sand-dark">Your kit</p>
          <h3 class="text-xl font-extrabold text-charcoal">${escapeHtml(rec.kitName)}</h3>
          <p class="text-sm text-muted-foreground">Estimated range <span data-bracket class="font-bold text-charcoal">${escapeHtml(bracket || '…')}</span>. Your quote has the exact price.</p>
        </div>

        <div class="mt-5">
          <p class="text-xs font-bold uppercase tracking-wider text-sand-dark mb-2">How ordering works</p>
          <ol class="space-y-2 text-sm text-charcoal">
            ${steps.map((s, i) => `<li class="flex gap-3"><span class="w-6 h-6 shrink-0 rounded-full bg-primary text-primary-foreground text-xs font-bold flex items-center justify-center">${i + 1}</span><span class="pt-0.5">${escapeHtml(s)}</span></li>`).join('')}
          </ol>
          <p class="mt-2 text-xs text-muted-foreground">${escapeHtml(ORDERING.note)}</p>
        </div>

        <div class="mt-5">
          <p class="text-xs font-bold uppercase tracking-wider text-sand-dark mb-2">What we'll quote you on</p>
          ${groups.map(({ g, items }) => `<p class="text-sm font-semibold text-charcoal mt-3 mb-1">${g === 'Gear' ? 'Gear' : g}</p><ul class="space-y-1.5 text-sm text-charcoal">${items.map((i) => `<li class="flex gap-2"><span class="${i.label.includes('not included') ? 'text-muted-foreground' : 'text-primary'}">${i.label.includes('not included') ? '&ndash;' : '&#10003;'}</span>${escapeHtml(i.label)}</li>`).join('')}</ul>`).join('')}
          <p class="text-sm font-semibold text-charcoal mt-3 mb-1">Every kit comes with</p>
          <ul class="space-y-1.5 text-sm text-muted-foreground">${rec.includes.map((i) => `<li class="flex gap-2"><span class="text-primary">&#10003;</span>${escapeHtml(i)}</li>`).join('')}</ul>
        </div>

        <button type="button" id="change-btn" class="mt-6 w-full min-h-[48px] bg-primary text-primary-foreground font-semibold rounded-md hover:bg-primary-light transition-colors">Change my build</button>
        <p class="mt-1.5 text-center text-xs text-muted-foreground">Change anything and send it again. We'll update your request.</p>
        <button type="button" id="another-btn" class="mt-3 w-full min-h-[48px] border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary/5 transition-colors">Start another build</button>
      `;
    }

    // -----------------------------------------------------------------------
    // Events (one set for every step, since the panel is re-rendered)
    // -----------------------------------------------------------------------

    const body = $('question-body');

    body.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      if (target.closest('[data-open-preview]')) {
        setOpen(true);
        if (isMobile()) $('viewer').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (target.closest('#next-btn')) {
        setOpen(false);
        goTo(CONTACT);
        return;
      }
      if (target.closest('#another-btn')) return startOver();
      if (target.closest('#change-btn')) return goTo(PICK);

      const supply = target.closest<HTMLButtonElement>('[data-supply]');
      if (supply) {
        const key = supply.dataset.supply as SupplyKey;
        if (supply.dataset.own === '1') answers[key] = true;
        else delete answers[key];
        save();
        refresh();
        renderPick();
        return;
      }

      const chip = target.closest<HTMLButtonElement>('[data-chip]');
      if (chip) {
        const name = chip.dataset.chip!;
        form[name] = form[name] === chip.dataset.value ? '' : chip.dataset.value!;
        save();
        chip.parentElement!.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) => {
          const on = form[name] === b.dataset.value;
          b.setAttribute('aria-checked', String(on));
          b.classList.toggle('border-primary', on);
          b.classList.toggle('bg-primary', on);
          b.classList.toggle('text-primary-foreground', on);
          b.classList.toggle('border-stone-dark/30', !on);
          b.classList.toggle('text-charcoal', !on);
          b.classList.toggle('bg-white', !on);
        });
        return;
      }

      const opt = target.closest<HTMLButtonElement>('.option');
      if (!opt) return;
      const q = opt.dataset.q!;
      const picked = opt.dataset.value!;
      if (q === 'build') {
        answers.build = picked as KitAnswers['build'];
        save();
        refresh();
        const y = window.scrollY;
        renderDetails();
        window.scrollTo({ top: y });
        return;
      }
      if (q === 'storage') {
        const list = new Set(answers.storage ?? []);
        const adding = !list.has(picked as never);
        adding ? list.add(picked as never) : list.delete(picked as never);
        answers.storage = [...list];
        if (adding) setOpen(true);
      } else {
        (answers as Record<string, unknown>)[q] = picked;
      }
      save();
      refresh();
      renderPick();
    });

    body.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const btn = f.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      if (f.id === 'contact-form') void submitContact(btn);
      if (f.id === 'details-form') void submitDetails(btn);
    });

    body.addEventListener('input', async (e) => {
      const t = e.target as HTMLInputElement;
      if (t.id === 'f-vehicleName') {
        answers.vehicleName = t.value.trim().slice(0, 80) || undefined;
        save();
        refresh();
        return;
      }
      if (t.id === 'loc-input') {
        form.location = t.value;
        delete form.suburb;
        delete form.state;
        delete form.postcode;
        save();
        try {
          const all = await loadPlaces();
          const q = t.value.trim().toLowerCase();
          if (!q) return showMatches([]);
          const digits = /^\d/.test(q);
          showMatches(all.filter((p) => (digits ? p.postcode.startsWith(q) : p.suburb.toLowerCase().startsWith(q))).slice(0, 8));
        } catch {
          showError('loc-error', 'Couldn\'t load the suburb list. Refresh the page and try again.');
        }
        return;
      }
      if (t.name && t.name !== 'vehicle') {
        form[t.name] = t.value;
        save();
      }
    });

    body.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.id === 'f-vehicle') {
        answers.vehicle = (t.value || undefined) as VehicleId | undefined;
        if (answers.vehicle !== 'other') delete answers.vehicleName;
        $('vehicle-name-wrap').classList.toggle('hidden', answers.vehicle !== 'other');
        save();
        refresh();
        return;
      }
      if (t.name === 'referral') {
        form.referral = t.value;
        save();
      }
    });

    body.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).id === 'loc-input') loadPlaces().catch(() => {});
    });

    body.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).id !== 'loc-input') return;
      const items = document.querySelectorAll<HTMLElement>('#loc-results li');
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!items.length) return;
        e.preventDefault();
        hi = e.key === 'ArrowDown' ? Math.min(hi + 1, items.length - 1) : Math.max(hi - 1, 0);
        items.forEach((el, i) => el.classList.toggle('bg-primary/10', i === hi));
        items[hi]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        // Enter picks the highlighted (or only) suburb instead of submitting early.
        if (matches.length && (hi >= 0 || matches.length === 1)) {
          e.preventDefault();
          pickPlace(matches[Math.max(hi, 0)]);
        }
      } else if (e.key === 'Escape') {
        showMatches([]);
      }
    });

    // mousedown so the pick lands before the input loses focus.
    body.addEventListener('mousedown', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[data-place]');
      if (!li) return;
      e.preventDefault();
      pickPlace(matches[Number(li.dataset.place)]);
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#loc-input, #loc-results')) {
        if (document.getElementById('loc-results') && !document.getElementById('loc-results')!.classList.contains('hidden')) showMatches([]);
      }
    });

    // -----------------------------------------------------------------------
    // Boot
    // -----------------------------------------------------------------------

    history.replaceState({ kitStep: step }, '');
    refresh();
    render();
    initScene();
  </script>
</BaseLayout>
