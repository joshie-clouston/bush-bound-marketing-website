---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';

const usps = [
  { title: 'CNC cut to the millimetre', text: 'No panel saw, no wobbly jigsaw lines. Every panel is machine cut, numbered and pre-drilled.' },
  { title: 'Floor template included', text: 'Drill exactly where it\'s safe. Our template keeps you clear of fuel tanks, brake lines and wiring.' },
  { title: 'Materials dialled in', text: 'The same premium birch ply, slides and hardware we use in our full workshop builds.' },
  { title: 'Build it in a weekend', text: 'A drill, a few clamps and a mate. Or add our build and install service if you\'d rather not.' },
];

const comparison = [
  { label: 'Design time', diy: 'Weeks of YouTube and sketching', kit: 'Done for you in 3D, approved before we cut' },
  { label: 'Cutting', diy: 'Panel saw or circular saw, rough edges', kit: 'CNC cut, clean edges, perfect joins' },
  { label: 'Materials', diy: 'Guesswork at the hardware store', kit: 'Premium birch ply and rated slides' },
  { label: 'Floor mounting', diy: 'Fingers crossed you miss the fuel tank', kit: 'Vehicle-specific floor template' },
  { label: 'Build time', diy: 'Most weekends for a couple of months', kit: 'One weekend' },
];

const viewerBtn = 'min-h-[44px] bg-black/35 hover:bg-black/50 backdrop-blur text-stone-light text-xs font-semibold px-3 rounded-md transition-colors';
---

<BaseLayout
  title="Build Your Flat Pack Fit-Out Kit | DIY 4WD Wagon Kits | Bush Bound"
  description="Design your own flat pack 4WD fit-out kit for your LandCruiser, Patrol, Prado and more. Pick your fridge and options, watch it build in 3D, and get an official quote."
>
  <style is:global>
    #viewer-canvas canvas { width: 100% !important; height: 100% !important; display: block; }
    /* Keep the question in view below the pinned 3D viewer on phones. */
    #question-panel, #summary { scroll-margin-top: calc(6.25rem + max(48vh, 300px) + 0.75rem); }
    @media (min-width: 1024px) { #question-panel, #summary { scroll-margin-top: 8rem; } }
  </style>

  <!-- INTRO -->
  <section class="bg-charcoal text-stone-light">
    <div class="container-wide pt-8 pb-6 sm:pt-14 sm:pb-10">
      <p class="text-sand font-medium text-sm uppercase tracking-widest mb-3">Flat Pack Fit-Out Kits</p>
      <h1 class="text-3xl sm:text-5xl font-extrabold max-w-3xl">Build your wagon fit-out. Watch it come together.</h1>
      <p class="text-stone-dark mt-4 max-w-2xl text-base sm:text-lg">
        Pick your fridge and options, watch it build in 3D, and see a price range before you ask for an official quote.
      </p>
    </div>
  </section>

  <!-- BUILDER -->
  <section class="bg-background" id="builder">
    <div class="container-wide py-4 lg:py-10">
      <div class="grid lg:grid-cols-12 gap-5 lg:gap-10">

        <!-- 3D viewer (pinned while you scroll) -->
        <div class="lg:col-span-7 lg:order-2 sticky top-[6.25rem] lg:top-[7.25rem] self-start z-20 -mx-5 sm:mx-0">
          <div id="viewer" class="relative flex flex-col h-[48vh] min-h-[300px] lg:h-[calc(100vh-9rem)] lg:max-h-[720px] sm:rounded-xl overflow-hidden bg-gradient-to-b from-[#7a7e7c] to-[#4d5150] shadow-lg lg:shadow-none">
            <div class="relative flex-1 min-h-0"><div id="viewer-canvas" class="absolute inset-0"></div></div>

            <div class="absolute top-2.5 left-3 right-3 z-10 flex items-start justify-between gap-3 pointer-events-none">
              <div class="min-w-0">
                <p id="viewer-vehicle" class="text-stone-light font-bold text-sm sm:text-base truncate">LandCruiser 200 Series</p>
                <p id="viewer-changes" class="text-stone-light/80 text-xs mt-0.5 line-clamp-1 sm:line-clamp-2"></p>
              </div>
              <div class="text-right shrink-0">
                <p data-bracket class="bg-sand text-charcoal text-sm font-extrabold px-2.5 py-1 rounded-full whitespace-nowrap">…</p>
                <p class="text-[10px] text-stone-light/75 mt-0.5">Estimated range</p>
              </div>
            </div>

            <div class="sm:absolute sm:bottom-2.5 sm:left-3 sm:right-3 flex items-center sm:items-end justify-between gap-2 px-3 py-1 sm:p-0 bg-[#4d5150] sm:bg-transparent">
              <p class="text-stone-light/75 text-[11px] leading-snug hidden sm:block max-w-[45%]">
                <span class="hidden lg:inline">Drag to rotate · Ctrl + scroll to zoom.</span>
                Tap Open to see the drawers, bed and table in action.
              </p>
              <div class="flex gap-1.5 ml-auto">
                <button id="toggle-open" type="button" aria-pressed="false" class={`${viewerBtn} min-w-[72px]`}>Open</button>
                <button id="reset-view" type="button" class={viewerBtn} aria-label="Reset 3D view">Reset</button>
              </div>
            </div>

            <div id="viewer-fallback" class="hidden absolute inset-0 items-center justify-center p-6 text-center text-stone-light/80 text-sm">
              Your browser can't show the 3D preview, but the options and quote request still work fine.
            </div>
          </div>
          <ul id="module-chips" class="hidden lg:flex flex-wrap gap-2 mt-3" aria-label="What's in your layout"></ul>
        </div>

        <!-- Questionnaire -->
        <div class="lg:col-span-5 lg:order-1">
          <div id="question-panel" class="bg-white rounded-xl border border-stone-dark/20 p-5 sm:p-7 shadow-sm">
            <div id="panel-head" class="flex items-center justify-between gap-3 mb-4">
              <button id="back-btn" type="button" class="min-h-[44px] -ml-2 px-2 text-sm font-medium text-primary hover:text-primary-light disabled:invisible flex items-center gap-1" disabled>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                Back
              </button>
              <div class="flex items-center gap-3">
                <button id="start-over" type="button" class="hidden min-h-[44px] px-2 text-xs font-semibold text-muted-foreground hover:text-primary underline">Start over</button>
                <p id="step-count" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">1 of 8</p>
                <button id="see-kit" type="button" class="hidden min-h-[44px] px-3 text-xs font-bold bg-sand text-charcoal rounded-md">See my kit</button>
              </div>
            </div>
            <div id="panel-progress" class="h-1.5 bg-stone rounded-full overflow-hidden mb-6">
              <div id="progress-bar" class="h-full bg-primary rounded-full transition-all duration-500" style="width: 10%"></div>
            </div>
            <div id="question-body" aria-live="polite"></div>
          </div>

          <div id="summary" class="hidden space-y-5"></div>

          <ol id="answered" class="mt-5 flex flex-wrap gap-2" aria-label="Your answers"></ol>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY A KIT -->
  <section class="section-padding bg-stone">
    <div class="container-wide">
      <div class="text-center mb-12">
        <p class="text-sand-dark font-medium text-sm uppercase tracking-widest mb-3" data-animate="fade-in">Why a Bush Bound kit</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-charcoal" data-animate="fade-up">All the craftsmanship, none of the sawdust</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6" data-animate="stagger">
        {usps.map((u) => (
          <div class="bg-white rounded-xl p-6 border border-stone-dark/10">
            <h3 class="text-lg font-bold text-charcoal mb-2">{u.title}</h3>
            <p class="text-sm text-muted-foreground">{u.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 bg-white rounded-xl border border-stone-dark/10 overflow-hidden" data-animate="fade-up">
        <div class="grid grid-cols-3 text-xs sm:text-sm font-semibold bg-charcoal text-stone-light">
          <div class="p-3 sm:p-4"></div>
          <div class="p-3 sm:p-4">Doing it from scratch</div>
          <div class="p-3 sm:p-4 text-sand">Bush Bound kit</div>
        </div>
        {comparison.map((row) => (
          <div class="grid grid-cols-3 text-xs sm:text-sm border-t border-stone-dark/10">
            <div class="p-3 sm:p-4 font-semibold text-charcoal">{row.label}</div>
            <div class="p-3 sm:p-4 text-muted-foreground">{row.diy}</div>
            <div class="p-3 sm:p-4 text-charcoal">{row.kit}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    import { QUESTIONS, VEHICLES, getVehicle, type Question, type VehicleId } from '@/data/kit-builder';
    import { carpetOn, isAsked, recommend, sanitiseAnswers, type KitAnswers, type Recommendation } from '@/lib/kit-builder/engine';
    import { getUtmParams } from '@/lib/utm';
    import type { KitScene } from '@/lib/kit-builder/scene';

    const STORAGE_KEY = 'bb-kit-builder-v5';
    const INTRO = -1;
    const SUMMARY = QUESTIONS.length;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const isMobile = () => window.innerWidth < 1024;

    let answers: KitAnswers = {};
    let step = INTRO;
    /** Where a returning customer got to, offered on the intro screen. */
    let savedStep: number | null = null;
    let scene: KitScene | null = null;
    /** Set when the customer jumps back from the summary to change one answer. */
    let returnToSummary = false;
    /** Order form values survive re-rendering the summary. */
    const formDraft: Record<string, string> = {};
    /** Latest price bracket from the server (we never ship prices to the browser). */
    let bracket = '';

    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (saved && typeof saved === 'object') {
        answers = sanitiseAnswers(saved.answers);
        const s = Math.min(Math.max(INTRO, saved.step | 0), SUMMARY);
        if (s > INTRO) savedStep = s;
      }
    } catch { /* storage unavailable, start fresh */ }

    function save() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ answers, step })); } catch { /* ignore */ }
    }

    // -----------------------------------------------------------------------
    // Price bracket (from the server)
    // -----------------------------------------------------------------------

    let estimateTimer = 0;
    let estimateSeq = 0;
    function requestEstimate() {
      window.clearTimeout(estimateTimer);
      estimateTimer = window.setTimeout(async () => {
        const seq = ++estimateSeq;
        try {
          const res = await fetch('/api/kit-estimate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ answers }) });
          const data = (await res.json()) as { bracket?: string };
          if (seq !== estimateSeq || !data.bracket) return;
          bracket = data.bracket;
          document.querySelectorAll('[data-bracket]').forEach((el) => { el.textContent = bracket; });
        } catch { /* keep the last bracket */ }
      }, 250);
    }

    // -----------------------------------------------------------------------
    // 3D viewer
    // -----------------------------------------------------------------------

    function webglAvailable() {
      try {
        const c = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
      } catch {
        return false;
      }
    }

    async function initScene() {
      if (!webglAvailable()) {
        const fb = $('viewer-fallback');
        fb.classList.remove('hidden');
        fb.classList.add('flex');
        return;
      }
      const { KitScene } = await import('@/lib/kit-builder/scene');
      scene = new KitScene($('viewer-canvas'));
      if (import.meta.env.DEV) (window as unknown as Record<string, unknown>).__kitScene = scene;
      refresh();
    }

    function setOpen(open: boolean) {
      const btn = $('toggle-open');
      btn.setAttribute('aria-pressed', String(open));
      btn.textContent = open ? 'Close' : 'Open';
      scene?.setOpen(open);
    }
    $('toggle-open').addEventListener('click', (e) => setOpen((e.currentTarget as HTMLElement).getAttribute('aria-pressed') !== 'true'));
    $('reset-view').addEventListener('click', () => scene?.resetView());

    const MODULE_LABELS: Record<string, string> = {
      drawer: 'Drawers',
      'fridge-upright': 'Upright fridge',
      'drawer-fridge': 'Drawer fridge',
      'fridge-chest': 'Chest fridge',
      cubby: 'Table cubby',
      slats: 'Pull-out bed',
      'end-panel': 'Power panels',
    };

    function vehicleName() {
      if (answers.vehicle === 'other') return answers.vehicleName || 'Your vehicle';
      return getVehicle(answers.vehicle).label;
    }

    function refresh(): Recommendation {
      const rec = recommend(answers);
      $('viewer-vehicle').textContent = answers.vehicle ? vehicleName() : `Preview: ${getVehicle(undefined).short}`;
      $('viewer-changes').textContent = rec.addOns.join(' · ');
      const kinds = [...new Set(rec.layout.modules.map((m) => (m.kind === 'end-panel' && !m.fixtures?.length ? '' : m.kind)))].filter((k) => MODULE_LABELS[k]);
      $('module-chips').innerHTML = kinds.map((k) => `<li class="text-xs font-medium bg-white border border-stone-dark/20 text-charcoal px-2.5 py-1 rounded-full">${MODULE_LABELS[k]}</li>`).join('');
      scene?.update(rec.layout, { fronts: answers.finish ?? 'hex', carpet: carpetOn(answers) });
      requestEstimate();
      return rec;
    }

    // -----------------------------------------------------------------------
    // Navigation (skips questions that don't apply, supports browser Back)
    // -----------------------------------------------------------------------

    const value = (id: string) => (answers as Record<string, unknown>)[id];
    const asked = () => QUESTIONS.map((q, i) => ({ q, i })).filter(({ q }) => isAsked(q, answers));

    function isAnswered(q: Question) {
      const v = value(q.id);
      return q.multi ? Array.isArray(v) : v !== undefined;
    }
    const allAnswered = () => asked().every(({ q }) => isAnswered(q));

    function nextIndex(from: number) {
      for (let i = from + 1; i < QUESTIONS.length; i++) if (isAsked(QUESTIONS[i], answers)) return i;
      return SUMMARY;
    }
    function prevIndex(from: number) {
      for (let i = Math.min(from, QUESTIONS.length) - 1; i >= 0; i--) if (isAsked(QUESTIONS[i], answers)) return i;
      return INTRO;
    }

    function render() {
      $('start-over').classList.toggle('hidden', step === INTRO);
      $('panel-head').classList.toggle('hidden', step === INTRO);
      $('panel-progress').classList.toggle('hidden', step === INTRO);
      if (step === INTRO) return renderIntro();
      if (step < SUMMARY && !isAsked(QUESTIONS[step], answers)) step = nextIndex(step);
      if (step >= SUMMARY) renderSummary();
      else renderQuestion();
    }

    function goTo(next: number, opts: { push?: boolean; replace?: boolean; scroll?: boolean } = {}) {
      step = Math.max(INTRO, Math.min(next, SUMMARY));
      save();
      if (opts.replace) history.replaceState({ kitStep: step }, '');
      else if (opts.push !== false) history.pushState({ kitStep: step }, '');
      render();
      if (opts.scroll !== false && isMobile()) (step >= SUMMARY ? $('summary') : $('question-panel')).scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function goNext() {
      if (returnToSummary && allAnswered()) {
        returnToSummary = false;
        goTo(SUMMARY);
      } else {
        goTo(nextIndex(step));
      }
    }

    window.addEventListener('popstate', (e) => {
      const s = (e.state as { kitStep?: number } | null)?.kitStep;
      if (typeof s === 'number') goTo(s, { push: false });
    });

    $('back-btn').addEventListener('click', () => goTo(prevIndex(step), { replace: true }));

    /** Clear everything and go back to the first option. */
    function startOver() {
      answers = {};
      savedStep = null;
      returnToSummary = false;
      for (const k of Object.keys(formDraft)) delete formDraft[k];
      setOpen(false);
      refresh();
      goTo(0);
    }
    $('start-over').addEventListener('click', startOver);

    // -----------------------------------------------------------------------
    // Intro: show the fit-out first, then start building
    // -----------------------------------------------------------------------

    function renderIntro() {
      $('question-panel').classList.remove('hidden');
      $('summary').classList.add('hidden');
      $('answered').classList.add('hidden');
      $<HTMLButtonElement>('back-btn').disabled = true;
      $('step-count').textContent = '';
      $('progress-bar').style.width = '0%';
      $('see-kit').classList.add('hidden');
      const resuming = savedStep !== null;
      $('question-body').innerHTML = `
        <p class="text-sand-dark font-medium text-xs uppercase tracking-widest mb-2">Wagon fit-out builder</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-charcoal">${resuming ? 'Welcome back' : 'This is our wagon base kit'}</h2>
        <p class="text-sm text-muted-foreground mt-2">${resuming
          ? 'Here\'s the fit-out you were putting together.'
          : 'Black honeycomb birch ply, evenly split drawers and an upright fridge, cut to suit your vehicle.'} Tap <button type="button" data-open-preview class="font-semibold text-primary underline">Open</button> on the model to see the drawers, bed and table in action.</p>
        <ul class="mt-4 space-y-1.5 text-sm text-charcoal">
          <li class="flex gap-2"><span class="text-primary">&#10003;</span>Pick your fridge, then add a sliding bed or tables</li>
          <li class="flex gap-2"><span class="text-primary">&#10003;</span>Watch the model update as you go</li>
          <li class="flex gap-2"><span class="text-primary">&#10003;</span>See a price range, then get an official quote</li>
        </ul>
        ${resuming
          ? `<button type="button" id="resume-btn" class="mt-6 w-full min-h-[52px] bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary-light transition-colors">Pick up where you left off</button>
             <button type="button" id="fresh-btn" class="mt-2 w-full min-h-[48px] text-primary font-semibold hover:underline">Start fresh</button>`
          : `<button type="button" id="start-btn" class="mt-6 w-full min-h-[52px] bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary-light transition-colors">Start building yours</button>`}
      `;
    }
    $('see-kit').addEventListener('click', () => {
      returnToSummary = false;
      goTo(SUMMARY);
    });

    function jumpTo(i: number) {
      returnToSummary = allAnswered();
      goTo(i);
    }

    // -----------------------------------------------------------------------
    // Answer chips
    // -----------------------------------------------------------------------

    function answerLabel(q: Question) {
      const v = value(q.id);
      if (Array.isArray(v)) return v.length ? v.map((x) => q.options.find((o) => o.value === x)?.label ?? x).join(', ') : 'None';
      let label = q.options.find((o) => o.value === v)?.label ?? '';
      if (q.id === 'fridge' && answers.ownFridge) label += ' (have one)';
      return label;
    }

    function chipsHtml(skip = -1) {
      return asked().map(({ q, i }) => {
        if (!isAnswered(q) || i === skip) return '';
        return `<li><button type="button" data-jump="${i}" class="min-h-[44px] inline-flex items-center text-left text-sm bg-white border border-stone-dark/20 hover:border-primary text-charcoal px-3 py-2 rounded-lg transition-colors"><span><span class="text-muted-foreground">${escapeHtml(q.title)}:</span> ${escapeHtml(answerLabel(q))}</span></button></li>`;
      }).join('');
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-jump]');
      if (btn) jumpTo(Number(btn.dataset.jump));
    });

    // -----------------------------------------------------------------------
    // Question rendering
    // -----------------------------------------------------------------------

    const nextLabel = () => {
      if (returnToSummary && allAnswered()) return 'Back to my kit';
      return nextIndex(step) >= SUMMARY ? 'See my kit' : 'Next';
    };
    const nextButton = (label = nextLabel(), disabled = false) =>
      `<button type="button" id="next-btn" ${disabled ? 'disabled' : ''} class="mt-5 w-full min-h-[48px] py-3 bg-primary text-primary-foreground font-semibold rounded-md hover:bg-primary-light transition-colors disabled:opacity-40">${label}</button>`;


    function renderQuestion() {
      const q = QUESTIONS[step];
      const list = asked();
      const pos = list.findIndex((x) => x.i === step);
      $('question-panel').classList.remove('hidden');
      $('summary').classList.add('hidden');
      $('answered').classList.remove('hidden');
      $<HTMLButtonElement>('back-btn').disabled = false;
      $('step-count').textContent = `${pos + 1} of ${list.length}`;
      $('progress-bar').style.width = `${((pos + 1) / (list.length + 1)) * 100}%`;
      $('see-kit').classList.toggle('hidden', !allAnswered());
      $('answered').innerHTML = chipsHtml(step);

      // Options start with our base build's pick (the foldable table storage).
      if (q.id === 'storage' && !Array.isArray(answers.storage)) {
        answers.storage = ['cubby'];
        save();
        refresh();
      }

      const v = value(q.id);
      const selected = (x: string) => (Array.isArray(v) ? v.includes(x) : v === x);
      const grid = 'grid-cols-1';

      const optionHtml = q.options.map((o, i) => {
        const isSel = selected(o.value);
        const heading = o.group && o.group !== q.options[i - 1]?.group ? `<p class="col-span-full text-xs font-bold uppercase tracking-wider text-sand-dark ${i ? 'mt-3' : ''}">${escapeHtml(o.group)}</p>` : '';
        return `${heading}
          <button type="button" data-value="${o.value}" role="${q.multi ? 'checkbox' : 'radio'}" aria-checked="${isSel}"
            class="option min-h-[56px] text-left rounded-lg border-2 px-4 py-3 transition-all ${isSel ? 'border-primary bg-primary/5' : 'border-stone-dark/30 hover:border-primary/60 bg-white'}">
            <span class="flex items-start justify-between gap-2">
              <span class="block font-semibold text-charcoal text-sm sm:text-base">${escapeHtml(o.label)}</span>
              ${q.multi ? `<span class="w-5 h-5 shrink-0 rounded border-2 flex items-center justify-center ${isSel ? 'bg-primary border-primary text-white' : 'border-stone-dark'}">${isSel ? '&#10003;' : ''}</span>` : ''}
            </span>
            ${o.sub ? `<span class="block text-xs text-muted-foreground mt-0.5">${escapeHtml(o.sub)}</span>` : ''}
          </button>`;
      }).join('');

      let extras = '';
      if (q.id === 'fridge' && v !== undefined) {
        extras += `
          <label class="mt-4 flex items-center gap-3 min-h-[48px] cursor-pointer rounded-lg bg-stone-light px-4 py-2 text-sm text-charcoal">
            <input id="own-fridge" type="checkbox" class="w-5 h-5 accent-[#2D4A3E]" ${answers.ownFridge ? 'checked' : ''} />
            <span><strong>I already have this fridge.</strong> Just build around it.</span>
          </label>`;
      }
      if (q.id === 'storage' && answers.storage?.length) {
        extras += `<p class="mt-4 text-sm text-muted-foreground">Tap <button type="button" data-open-preview class="font-semibold text-primary underline">Open</button> on the model to see them in action.</p>`;
      }

      let footer = '';
      if (q.multi) footer = nextButton((v as string[] | undefined)?.length ? nextLabel() : `None, ${nextLabel().toLowerCase()}`);
      else if (v !== undefined) footer = nextButton();

      $('question-body').innerHTML = `
        <h2 class="text-2xl font-bold text-charcoal">${escapeHtml(q.title)}</h2>
        <p class="text-sm text-muted-foreground mt-1.5 mb-5">${escapeHtml(q.help)}</p>
        <div class="grid ${grid} gap-2.5" role="${q.multi ? 'group' : 'radiogroup'}" aria-label="${escapeHtml(q.title)}">${optionHtml}</div>
        ${extras}
        ${footer}
      `;
    }

    function rerender() {
      save();
      refresh();
      renderQuestion();
    }

    $('question-body').addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#start-btn')) {
        setOpen(false);
        goTo(0);
        return;
      }
      if (target.closest('#resume-btn')) {
        const to = savedStep ?? 0;
        savedStep = null;
        goTo(to);
        return;
      }
      if (target.closest('#fresh-btn')) return startOver();
      if (target.closest('[data-open-preview]') && step === INTRO) {
        setOpen(true);
        if (isMobile()) $('viewer').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      const q = QUESTIONS[step];
      if (!q) return;

      if (target.closest('#next-btn')) {
        if (q.multi && !Array.isArray(value(q.id))) (answers as Record<string, unknown>)[q.id] = [];
        save();
        goNext();
        return;
      }
      if (target.closest('[data-open-preview]')) {
        setOpen(true);
        if (isMobile()) $('viewer').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const btn = target.closest<HTMLButtonElement>('.option');
      if (!btn) return;
      const picked = btn.dataset.value!;

      if (q.multi) {
        const list = new Set((value(q.id) as string[] | undefined) ?? []);
        const adding = !list.has(picked);
        adding ? list.add(picked) : list.delete(picked);
        (answers as Record<string, unknown>)[q.id] = [...list];
        if (adding) setOpen(true);
        return rerender();
      }

      const already = value(q.id) === picked;
      (answers as Record<string, unknown>)[q.id] = picked;
      if (already) {
        save();
        refresh();
        goNext();
        return;
      }
      rerender();
    });

    $('question-body').addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.id === 'own-fridge') {
        if (t.checked) answers.ownFridge = true;
        else delete answers.ownFridge;
        rerender();
      }
    });

    // -----------------------------------------------------------------------
    // Summary + quote request
    // -----------------------------------------------------------------------

    function renderSummary() {
      const rec: Recommendation = refresh();
      $('question-panel').classList.add('hidden');
      $('answered').classList.add('hidden');
      const firstUnanswered = asked().find(({ q }) => !isAnswered(q));
      const groups = (['Cabinetry', 'Fridge', 'Power'] as const)
        .map((g) => ({ g, items: rec.items.filter((i) => i.group === g) }))
        .filter((x) => x.items.length);

      $('summary').classList.remove('hidden');
      $('summary').innerHTML = `
        <div class="bg-charcoal text-stone-light rounded-xl p-6 sm:p-7">
          <p class="text-sand text-xs font-bold uppercase tracking-widest mb-2">Your kit</p>
          <h2 class="text-3xl font-extrabold">${escapeHtml(rec.kitName)}</h2>
          <p class="text-stone-dark mt-1">${answers.vehicle ? `For your ${escapeHtml(vehicleName())}.` : 'Tell us your vehicle below and we\'ll cut it to suit.'}</p>
          <div class="mt-5 bg-stone-light/5 rounded-lg p-4">
            <p class="text-xs text-stone-dark uppercase tracking-wider font-semibold">Estimated range</p>
            <p class="text-3xl font-extrabold text-sand" data-bracket>${escapeHtml(bracket || '…')}</p>
            <p class="text-xs text-stone-dark mt-1">A rough guide only. Your official quote has the exact price for your vehicle.</p>
            <a href="#order-form" class="mt-4 inline-flex items-center justify-center w-full min-h-[48px] bg-sand text-charcoal font-bold rounded-md hover:bg-sand-light transition-colors">Get an official quote</a>
          </div>
          <ul class="flex flex-wrap gap-2 mt-4">${rec.addOns.map((a) => `<li class="text-xs font-semibold bg-sand/90 text-charcoal px-2.5 py-1 rounded-full">${escapeHtml(a)}</li>`).join('')}</ul>
          ${firstUnanswered ? `<button type="button" data-jump="${firstUnanswered.i}" class="mt-4 min-h-[44px] text-sm text-sand underline">You skipped a question. Answer it for a sharper estimate</button>` : ''}
          <button type="button" data-start-over class="mt-2 min-h-[44px] text-sm text-stone-dark underline">Start over</button>
          <h3 class="text-sm font-bold uppercase tracking-wider text-sand mt-6 mb-2">Your layout</h3>
          <ul class="space-y-2 text-sm">
            ${rec.why.map((w) => `<li class="flex gap-2"><span class="text-sand mt-0.5">&#10003;</span><span>${escapeHtml(w)}</span></li>`).join('')}
          </ul>
        </div>

        <div class="bg-white rounded-xl border border-stone-dark/20 p-5 sm:p-6">
          <h3 class="font-bold text-charcoal text-lg mb-1">Your picks</h3>
          <p class="text-sm text-muted-foreground mb-3">Tap one to change it. You'll come straight back here.</p>
          <ol class="flex flex-wrap gap-2">${chipsHtml()}</ol>
        </div>

        <div class="bg-white rounded-xl border border-stone-dark/20 p-5 sm:p-6">
          <h3 class="font-bold text-charcoal text-lg mb-3">What we'll quote you on</h3>
          ${groups.map(({ g, items }) => `
            <p class="text-xs font-bold uppercase tracking-wider text-sand-dark mt-3 mb-1.5">${g}</p>
            <ul class="space-y-1.5 text-sm text-charcoal">${items.map((i) => `<li class="flex gap-2"><span class="text-primary">&#10003;</span>${escapeHtml(i.label)}</li>`).join('')}</ul>`).join('')}
          <p class="text-xs font-bold uppercase tracking-wider text-sand-dark mt-5 mb-1.5">Every kit includes</p>
          <ul class="space-y-1.5 text-sm text-muted-foreground">${rec.includes.map((i) => `<li class="flex gap-2"><span class="text-primary">&#10003;</span>${escapeHtml(i)}</li>`).join('')}</ul>
        </div>

        ${rec.tips.length ? `
        <div class="bg-stone rounded-xl p-5 sm:p-6">
          <h3 class="font-bold text-charcoal text-lg mb-3">Straight-up advice</h3>
          <ul class="space-y-3 text-sm">${rec.tips.map((t) => `<li class="text-charcoal">${escapeHtml(t)}</li>`).join('')}</ul>
        </div>` : ''}

        <form id="order-form" class="bg-white rounded-xl border-2 border-primary p-5 sm:p-6 space-y-4" novalidate style="scroll-margin-top: calc(6.25rem + max(48vh, 300px) + 0.75rem)">
          <div>
            <h3 class="font-bold text-charcoal text-xl">Get your official quote</h3>
            <p class="text-sm text-muted-foreground mt-1">Free and no obligation. Luke will check your picks and send you an exact price within 48 hours.</p>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            <label class="block text-sm sm:col-span-2"><span class="font-medium text-charcoal">What are you driving?</span>
              <select id="vehicle-select" name="vehicle" class="mt-1 w-full min-h-[48px] rounded-md border border-stone-dark/40 px-3 py-2.5 text-base bg-white focus:border-primary focus:outline-none">
                <option value="">Pick your vehicle</option>
                ${VEHICLES.map((veh) => `<option value="${veh.id}" ${answers.vehicle === veh.id ? 'selected' : ''}>${escapeHtml(veh.id === 'other' ? 'Something else' : veh.label)}</option>`).join('')}
              </select></label>
            <label id="vehicle-name-wrap" class="block text-sm sm:col-span-2 ${answers.vehicle === 'other' ? '' : 'hidden'}"><span class="font-medium text-charcoal">Make and model</span>
              <input id="vehicle-name" type="text" maxlength="80" placeholder="e.g. 2016 Toyota Fortuner" value="${escapeHtml(answers.vehicleName ?? '')}"
                class="mt-1 w-full min-h-[48px] rounded-md border border-stone-dark/40 px-3 py-2.5 text-base focus:border-primary focus:outline-none" /></label>
            ${[
              ['name', 'Name', 'text', 'name'],
              ['phone', 'Mobile', 'tel', 'tel'],
              ['email', 'Email', 'email', 'email'],
              ['postcode', 'Postcode', 'text', 'postal-code'],
            ].map(([name, label, type, ac]) => `
              <label class="block text-sm"><span class="font-medium text-charcoal">${label}</span>
                <input name="${name}" type="${type}" autocomplete="${ac}" ${name === 'postcode' ? 'inputmode="numeric" maxlength="4"' : ''} value="${escapeHtml(formDraft[name] ?? '')}"
                  class="mt-1 w-full min-h-[48px] rounded-md border border-stone-dark/40 px-3 py-2.5 text-base focus:border-primary focus:outline-none" /></label>`).join('')}
          </div>
          <label class="block text-sm"><span class="font-medium text-charcoal">Anything else? <span class="text-muted-foreground font-normal">(model year, 12V or 240V power, finish, whether you'd like us to build or install it)</span></span>
            <textarea name="notes" rows="3" maxlength="2000" class="mt-1 w-full rounded-md border border-stone-dark/40 px-3 py-2.5 text-base focus:border-primary focus:outline-none">${escapeHtml(formDraft.notes ?? '')}</textarea></label>
          <p id="order-error" class="hidden text-sm text-destructive"></p>
          <button type="submit" class="w-full min-h-[52px] py-3.5 bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary-light transition-colors disabled:opacity-60">Get my official quote</button>
        </form>
      `;
    }

    $('summary').addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-start-over]')) startOver();
    });

    $('summary').addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.id === 'vehicle-name') {
        answers.vehicleName = t.value.trim().slice(0, 80) || undefined;
        save();
        return;
      }
      if (t.name && t.name !== 'vehicle') formDraft[t.name] = t.value;
    });

    $('summary').addEventListener('change', (e) => {
      const t = e.target as HTMLSelectElement;
      if (t.id !== 'vehicle-select') return;
      answers.vehicle = (t.value || undefined) as VehicleId | undefined;
      if (answers.vehicle !== 'other') delete answers.vehicleName;
      $('vehicle-name-wrap').classList.toggle('hidden', answers.vehicle !== 'other');
      save();
      refresh();
      document.querySelector('#summary p.text-stone-dark')!.textContent = answers.vehicle ? `For your ${vehicleName()}.` : 'Tell us your vehicle below and we\'ll cut it to suit.';
    });

    $('summary').addEventListener('submit', async (e) => {
      const form = (e.target as HTMLElement).closest<HTMLFormElement>('#order-form');
      if (!form) return;
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const error = $('order-error');
      error.classList.add('hidden');

      if (!answers.vehicle) {
        error.textContent = 'Pick what you\'re driving so we can cut it to suit.';
        error.classList.remove('hidden');
        $('vehicle-select').focus();
        return;
      }
      if (!data.name?.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || '')) {
        error.textContent = 'Pop in your name and a valid email so we can send your quote.';
        error.classList.remove('hidden');
        return;
      }
      if (data.postcode && !/^\d{4}$/.test(data.postcode)) {
        error.textContent = 'Postcode should be 4 digits.';
        error.classList.remove('hidden');
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      submit.disabled = true;
      submit.textContent = 'Sending...';

      try {
        const res = await fetch('/api/kit-builder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ answers, contact: data, ...getUtmParams() }),
        });
        if (!res.ok) throw new Error(String(res.status));
        try { localStorage.removeItem(STORAGE_KEY); } catch { /* ignore */ }
        form.outerHTML = `
          <div class="bg-primary text-primary-foreground rounded-xl p-6 sm:p-7">
            <h3 class="text-2xl font-extrabold">Thanks ${escapeHtml(data.name.split(' ')[0])}, we've got it.</h3>
            <p class="mt-2 text-stone-dark">Luke will check your picks for your ${escapeHtml(vehicleName())} and send your official quote within 48 hours.</p>
            <button type="button" data-start-over class="mt-4 min-h-[44px] text-sm font-semibold text-sand underline">Start another build</button>
          </div>`;
        const { default: confetti } = await import('canvas-confetti');
        confetti({ particleCount: 120, spread: 70, origin: { y: 0.7 }, colors: ['#2D4A3E', '#C4A882', '#E8E0D6'] });
      } catch {
        submit.disabled = false;
        submit.textContent = 'Get my official quote';
        error.innerHTML = 'Something went wrong sending that. Give it another go, or call us on <a class="underline" href="tel:+61424770875">0424 770 875</a>.';
        error.classList.remove('hidden');
      }
    });

    // -----------------------------------------------------------------------
    // Boot
    // -----------------------------------------------------------------------

    history.replaceState({ kitStep: step }, '');
    refresh();
    render();
    initScene();
  </script>
</BaseLayout>
