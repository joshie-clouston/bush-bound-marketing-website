---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { electricalPhotos } from '@/data/electrical-photos';
import { faqs } from '@/data/faqs';

const gallerySlugs = ['bay-overview-1', 'monitor-outlet-timber-cabinet-1', 'bay-cerbo-gx-solar-1'];
const galleryImages = gallerySlugs.map((slug) => electricalPhotos.find((p) => p.slug === slug)!);

const signOffFaq = faqs.find((f) => f.slug === 'does-12v-240v-electrical-need-to-be-signed-off-by-an-electrician')!;

const pageTitle = '12V Electrical Specialists | Dual Battery Systems for Expedition Vehicles | Bush Bound';
const pageDescription = 'Bush Bound are 12V electrical specialists building dual battery systems for 4WDs, vans and expedition vehicles. 240V work is signed off by a licensed electrician.';
const pageUrl = 'https://bushbound.au/electrical-systems';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: '12V & 240V Vehicle Electrical Systems',
      serviceType: '12V and 240V vehicle electrical installation',
      description: 'Custom 12V dual battery systems and 240V electrical installations for 4WDs, vans and expedition vehicles, designed and signed off by a dual-qualified electrical engineer and licensed electrician.',
      url: pageUrl,
      areaServed: {
        '@type': 'State',
        name: 'Queensland',
      },
      provider: {
        '@type': 'LocalBusiness',
        name: 'Bush Bound',
        url: 'https://bushbound.au',
        telephone: '+61424770875',
        email: 'luke@bushbound.au',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Gold Coast',
          addressRegion: 'QLD',
          addressCountry: 'AU',
        },
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: signOffFaq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: signOffFaq.answer,
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bushbound.au/' },
        { '@type': 'ListItem', position: 2, name: '12V & 240V Electrical Systems', item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <!-- Hero -->
  <section class="section-padding bg-charcoal text-stone-light">
    <div class="container-narrow">
      <div class="max-w-3xl">
        <span class="inline-flex items-center px-3 py-1 bg-white/10 text-sand text-xs font-semibold rounded-full mb-4">Electrical Safety</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">
          12V &amp; 240V Electrical Systems. Qualified Electrician Sign-Off
        </h1>
        <p class="text-lg text-stone/90 max-w-2xl">
          One bad wiring job doesn't just trip a fuse. It can burn out your whole fit-out, and your vehicle with it. We're 12V electrical specialists, building dual battery systems for 4WDs, vans and expedition vehicles across Australia.
        </p>
        <a href="/quote" class="inline-flex items-center justify-center px-8 py-4 bg-sand text-charcoal font-bold text-base rounded-md hover:bg-sand-light transition-colors mt-8">
          Book a Job
        </a>
      </div>
    </div>
  </section>

  <!-- Photo gallery -->
  <section class="bg-background pt-8 sm:pt-12">
    <div class="container-narrow">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {galleryImages.map((img, i) => (
          <div class="rounded-xl overflow-hidden bg-stone aspect-square">
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>
      <p class="text-xs text-muted-foreground mt-3 text-center italic">Real electrical installs from Bush Bound customer builds.</p>
    </div>
  </section>

  <!-- Body -->
  <section class="section-padding bg-background">
    <div class="container-narrow max-w-3xl">
      <div class="space-y-6 text-charcoal/90 leading-relaxed">
        <p>Every 240V circuit we install is legally required to be signed off by a licensed electrician in Queensland. We go further. We have a dual-qualified electrical engineer and licensed electrician who's helped refine how we wire every Bush Bound build over the years.</p>

        <p>12V doesn't legally require an electrician's sign-off and most people skip it. We don't. Every 12V system is designed, inspected and certified to the same standard, because a dodgy 12V connection under your bed can start a fire just as easily as a bad 240V one.</p>
      </div>

      <div class="bg-charcoal text-stone-light rounded-xl p-6 sm:p-8 my-8">
        <p class="leading-relaxed">Cut corners with a dodgy DIY or your mate who's cheap and you're not just risking the fit-out. Insurers can decline claims linked to non-compliant electrical modifications. One bad connection could cost you your build, your vehicle, and your insurance cover.</p>
      </div>

      <p class="text-charcoal/90 leading-relaxed">Your 12V circuit runs the fridge, lights, phone chargers and more, whilst your 240V circuit runs laptops, coffee machines, induction cooktops, camera gear etc. Every 12V setup comes with 240V charging built in, so you can charge your battery at home or on a powered site.</p>
    </div>
  </section>

  <!-- What's included -->
  <section class="section-padding bg-stone">
    <div class="container-narrow max-w-3xl">
      <h2 class="text-2xl font-bold text-charcoal mb-8" data-animate="fade-up">What's covered by every Bush Bound electrical build</h2>
      <div class="grid sm:grid-cols-2 gap-4" data-animate="fade-up">
        {[
          'Dual battery and DC-DC charging systems',
          'Solar charge controllers and panels',
          'Inverters for 240V appliances',
          'Fused and correctly rated wiring looms',
          'GPO and USB outlet installation',
          'Design and sign-off by a dual-qualified electrical engineer and licensed electrician',
        ].map((item) => (
          <div class="flex items-center gap-3 bg-white rounded-lg p-4 border border-stone-dark/10">
            <span class="text-primary font-bold shrink-0">&#10003;</span>
            <span class="text-sm text-charcoal">{item}</span>
          </div>
        ))}
      </div>

      <a href={`/faq/${signOffFaq.slug}`} class="group flex items-center justify-between mt-8 p-5 bg-white rounded-xl border border-stone-dark/10 hover:border-primary/30 hover:shadow-sm transition-all">
        <span class="font-semibold text-charcoal group-hover:text-primary transition-colors">{signOffFaq.question}</span>
        <svg class="w-5 h-5 text-muted-foreground group-hover:text-primary shrink-0 ml-4 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden">
    <div class="bg-gradient-to-br from-primary-dark via-primary to-primary-light py-16 sm:py-20">
      <div class="container-narrow text-center relative z-10">
        <div class="flex items-center justify-center gap-1.5 mb-6">
          {[1,2,3,4,5].map(() => (
            <svg class="w-5 h-5 text-sand" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-primary-foreground mb-4">
          Get it wired right the first time
        </h2>
        <p class="text-stone-light/80 text-lg mb-8 max-w-lg mx-auto">
          Tell us about your vehicle and we'll give you a call to talk through your power needs and build something safe, compliant and built to last.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/quote" class="inline-flex items-center justify-center px-8 py-4 bg-sand text-charcoal font-bold text-base rounded-md hover:bg-sand-light transition-colors">
            Get a Free Quote
          </a>
          <a href="/fit-outs" class="inline-flex items-center justify-center px-8 py-4 border-2 border-stone-light/30 text-stone-light font-semibold text-base rounded-md hover:border-sand hover:text-sand transition-colors">
            See Our Builds
          </a>
        </div>
      </div>
      <div class="absolute top-0 left-0 w-64 h-64 bg-white/5 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-48 h-48 bg-white/5 rounded-full translate-x-1/3 translate-y-1/3"></div>
    </div>
  </section>

</BaseLayout>
